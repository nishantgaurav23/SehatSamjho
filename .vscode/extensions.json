    // ── Git & Collaboration ───────────────────────────────────────
    "eamodio.gitlens",            // Git blame, history, branch comparison
    "github.vscode-pull-request-github", // Review PRs directly in VS Code

    // ── Environment & Config ──────────────────────────────────────
    "mikestead.dotenv",           // .env file syntax highlighting

    // ── General Productivity ──────────────────────────────────────
    "usernamehw.errorlens",       // Inline error messages on the line they occur
    "streetsidesoftware.code-spell-checker" // Catches typos in code and comments
