    "ms-python.vscode-pylance",   // Fast type checking and IntelliSense
    "charliermarsh.ruff",         // Linter + formatter (replaces flake8 + black)

    // ── FastAPI / API ────────────────────────────────────────────
    "rangav.vscode-thunder-client", // Lightweight REST client (test webhook endpoints)

    // ── Docker ───────────────────────────────────────────────────
