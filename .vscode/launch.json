{
  "version": "0.2.0",
  "configurations": [
    {
      // ── FastAPI Dev Server ───────────────────────────────────────
      // Run and debug the FastAPI app directly in VS Code.
      // Set breakpoints in any service file — they will be hit on requests.
      "name": "FastAPI: Dev Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "justMyCode": false
    },
    {
      // ── Pytest: Full Suite ────────────────────────────────────────
      // Run all tests with the debugger attached.
      // Set breakpoints inside test files or service files.
      "name": "Pytest: All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v", "--tb=short"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      // ── Pytest: Current File ──────────────────────────────────────
      // Debug only the test file currently open in the editor.
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${relativeFile}", "-v"],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
