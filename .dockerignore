# Virtual environment — never copy into Docker
.venv/

# Git
.git/
.github/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
.pytest_cache/
.ruff_cache/
.coverage

# Dev/docs — not needed in image
docs/
infra/
data/
scripts/

# IDE / OS
.vscode/
.claude/
.idea/
.DS_Store

# Local env files — secrets must come from runtime env, not the image
.env
.env.*
!.env.example

# Temporary files
tmp/
*.log
