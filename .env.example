# ── OpenAI (GPT-4O Vision for prescription extraction) ────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Anthropic (Claude Sonnet 4.6 for translation) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Twilio (WhatsApp messaging) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Bhashini (TTS for Indian languages) ──────────────────────────────────────
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_USER_ID=your-bhashini-user-id-here

# ── AWS (S3 for audio storage) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET=sehatsamjho-audio

# ── Database (PostgreSQL via SQLAlchemy async) ───────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sehatsamjho

# ── Redis (sessions + drug cache + glossary cache) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
