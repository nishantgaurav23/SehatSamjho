# ─────────────────────────────────────────────────────────────────────────────
# SehatSamjho — Environment Variables
# Copy this to .env and fill in all values before running.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development  # development | staging | production

# ── OpenAI (GPT-4o Vision + LLM) ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=45

# ── Twilio (WhatsApp Business) ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox: whatsapp:+14155238886  |  Production: your approved WhatsApp number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Bhashini TTS (register free at bhashini.gov.in) ──────────────────────────
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local (docker-compose sets this automatically via environment: block)
DATABASE_URL=postgresql+asyncpg://sehat:sehatpassword@postgres:5432/sehatsamjho
# Staging/Prod (AWS RDS):
# DATABASE_URL=postgresql+asyncpg://sehat:<password>@<rds-endpoint>:5432/sehatsamjho

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Prod (AWS ElastiCache):
# REDIS_URL=redis://<elasticache-endpoint>:6379/0

# ── AWS (for audio file storage + deployment) ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=sehatsamjho-audio-dev
# Presigned URL expiry in seconds (how long the audio URL is valid)
AWS_S3_AUDIO_URL_EXPIRY=3600

# ── Drug Database ─────────────────────────────────────────────────────────────
# Optional: IndianMedicineDatabase.com API key (prototype uses CSV fallback)
INDIAN_MEDICINE_API_KEY=
INDIAN_MEDICINE_API_URL=https://api.indianmedicinedatabase.com/v1

# ── Analytics ─────────────────────────────────────────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# ── Session / Security ────────────────────────────────────────────────────────
# Redis TTL for user sessions (seconds)
SESSION_TTL_SECONDS=1800  # 30 minutes
# Twilio webhook signature validation (set to false only in dev)
VALIDATE_TWILIO_SIGNATURE=false

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AUDIO=true           # Set false to skip TTS (speeds up testing)
ENABLE_DRUG_LOOKUP=true     # Set false to skip drug DB enrichment
ENABLE_INDICTRANS2=false    # IndicTrans2 fallback (self-hosted, advanced)
ENABLE_ANALYTICS=true       # PostHog event tracking
